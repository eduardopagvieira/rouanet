	partition projetos = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(PastaDados & "\projetos_powerbi.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
					Tipos = Table.TransformColumnTypes(Cabecalhos, {{"pronac", type text}, {"nome", type text}, {"ano", Int64.Type}, {"data_inicio", type date}, {"data_termino", type date}, {"uf", type text}, {"regiao", type text}, {"municipio", type text}, {"area", type text}, {"segmento", type text}, {"tipologia", type text}, {"tipicidade", type text}, {"enquadramento", type text}, {"mecanismo", type text}, {"etapa", type text}, {"situacao_salic", type text}, {"proponente", type text}, {"cpf_cnpj", type text}, {"tipo_proponente", type text}, {"valor_proposta", type number}, {"valor_solicitado", type number}, {"valor_aprovado", type number}, {"valor_projeto", type number}, {"valor_captado", type number}, {"outras_fontes", type number}, {"aprovado", type logical}, {"captou", type logical}, {"taxa_captacao", type number}, {"alerta_valor", type text}, {"local_realizacao", type text}}, "pt-BR"),
					Periodo = Table.AddColumn(Tipos, "periodo_captacao", each if [ano] <= 2022 then "Captação encerrada (2019 a 2022)" else "Ainda captando (2023 a 2026)", type text)
				in
					Periodo

	annotation PBI_ResultType = Table
