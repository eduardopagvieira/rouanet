table projetos
	lineageTag: 31486a7b-35da-5b30-a1c6-228f9f5b9fc1

	measure 'Projetos aprovados' = CALCULATE ( COUNTROWS ( projetos ), projetos[aprovado] = TRUE () )
		formatString: #,0
		lineageTag: 3b6c6d80-7407-5abc-b9e9-1abf0f5950b6

	measure 'Valor aprovado' = CALCULATE ( SUM ( projetos[valor_aprovado] ), projetos[aprovado] = TRUE () )
		formatString: #,0
		lineageTag: e474749c-c087-5e7f-a123-5ea2348b72d8

	measure 'Valor captado' = CALCULATE ( SUM ( projetos[valor_captado] ), projetos[aprovado] = TRUE () )
		formatString: #,0
		lineageTag: 495325be-bd05-5f31-ad3e-9611506d3426

	measure 'Taxa de captação' = DIVIDE ( [Valor captado], [Valor aprovado] )
		formatString: 0.0%
		lineageTag: b2a2893b-576d-51f9-a9e6-529dac945276

	measure '% que captaram' = DIVIDE ( CALCULATE ( [Projetos aprovados], projetos[captou] = TRUE () ), [Projetos aprovados] )
		formatString: 0.0%
		lineageTag: af6384e4-77ca-59dc-bff1-cfb3ee7a1006

	measure 'Participação no captado' = DIVIDE ( [Valor captado], CALCULATE ( [Valor captado], ALLSELECTED ( projetos ) ) )
		formatString: 0.0%
		lineageTag: 34e41c5f-4dc5-5933-82c4-43d95b56183b

	measure 'Projetos aprovados 2019-2022' = CALCULATE ( [Projetos aprovados], projetos[ano] <= 2022 )
		formatString: #,0
		lineageTag: b0353e34-814f-5488-bd64-db0b1119d459

	measure 'Valor captado 2019-2022' = CALCULATE ( [Valor captado], projetos[ano] <= 2022 )
		formatString: #,0
		lineageTag: ab7032a3-1675-5b87-b009-3ad1f63ab943

	measure 'Taxa de captação 2019-2022' = CALCULATE ( [Taxa de captação], projetos[ano] <= 2022 )
		formatString: 0.0%
		lineageTag: 77acac15-25df-51b4-a61d-c5a898f045f4

	measure '% que captaram 2019-2022' = CALCULATE ( [% que captaram], projetos[ano] <= 2022 )
		formatString: 0.0%
		lineageTag: fece2c59-6536-58a1-9280-f52b8adcc61a

